rules_version = '2';
// O escritório MASON é acessado SOMENTE pelo servidor (Firebase Admin SDK), que ignora estas regras.
// Nenhum navegador, app ou pessoa pode ler ou gravar diretamente no banco — nem mesmo com login.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
