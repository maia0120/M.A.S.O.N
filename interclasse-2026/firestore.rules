rules_version = '2';
// Interclasse 2026 — regras do Firestore.
// Cole este arquivo inteiro em Firebase Console → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Gerenciador = quem tem um documento admins/{UID}
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function logado() { return request.auth != null; }
    function perfil() { return /databases/$(database)/documents/torcida/$(request.auth.uid); }
    function texto(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }

    // Campeonato: todo mundo lê; só o gerenciador grava
    match /camp/{id} {
      allow read: if true;
      allow write: if id == 'estado' && isAdmin();
    }

    // Admins: cada um só vê a própria linha; ninguém grava pelo site
    match /admins/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;
    }

    // Perfil do torcedor (nome e sala que aparecem no post fixado).
    // ultimoLance só pode ser gravado com a hora do servidor (anti-spam).
    match /torcida/{uid} {
      function valido(d) {
        return d.keys().hasOnly(['nome', 'turma', 'ultimoLance'])
          && texto(d.nome, 1, 40) && texto(d.turma, 1, 60);
      }
      function carimboOk() {
        let antes = resource == null ? null : resource.data.get('ultimoLance', null);
        let depois = request.resource.data.get('ultimoLance', null);
        return depois == antes || depois == request.time;
      }
      allow read: if logado() && (request.auth.uid == uid || isAdmin());
      allow create, update: if logado() && request.auth.uid == uid && valido(request.resource.data) && carimboOk();
      allow delete: if isAdmin();
    }

    // Pedidos de post fixado: R$ 1,50, sempre "pendente" ao criar, com o nome e a sala
    // do próprio perfil e no máximo 1 a cada 30 segundos. Só o gerenciador aprova ou recusa.
    match /lances/{lid} {
      allow read: if isAdmin() || (logado() && resource.data.autorId == request.auth.uid);
      allow create: if logado()
        && request.resource.data.keys().hasOnly(['autorId', 'autorNome', 'autorSala', 'texto', 'valor', 'codigo', 'criadoEm', 'status'])
        && request.resource.data.autorId == request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.valor == 1.5
        && texto(request.resource.data.texto, 1, 280)
        && texto(request.resource.data.codigo, 4, 8)
        && request.resource.data.criadoEm == request.time
        && request.resource.data.autorNome == get(perfil()).data.nome
        && request.resource.data.autorSala == get(perfil()).data.turma
        && getAfter(perfil()).data.ultimoLance == request.time
        && (get(perfil()).data.get('ultimoLance', null) == null
            || get(perfil()).data.ultimoLance < request.time - duration.value(30, 's'));
      allow update, delete: if isAdmin();
    }

    // Topo e fila (topo/atual) e Pix para os pedidos (config/pix): todos leem, só o gerenciador grava
    match /topo/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Qualquer outra coleção (ex.: posts de um mural público) fica bloqueada.
  }
}
